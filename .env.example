# Copy to .env and fill in. Never commit .env.

# Long random text. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Addresses people use to reach this server (comma separated). More can be
# added later in Admin > Network settings without a restart.
ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed when you use a domain or https, e.g. https://tv.example.com
CSRF_TRUSTED_ORIGINS=
# true when served over https
SECURE_COOKIES=false

# Port on this computer.
PORT=8080

# Your time zone (prayer countdown, logs, "today").
TIME_ZONE=Asia/Dubai

# First start only: creates this admin if there is none. Change the password after logging in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Largest upload per file, in MB (also raise client_max_body_size in docker/nginx.conf if above 2048).
MAX_UPLOAD_MB=1024

# Name in the admin header and browser tab.
APP_NAME=FrontDesk

# Optional Cloudflare Tunnel (docker compose --profile tunnel up -d)
TUNNEL_TOKEN=

WEB_WORKERS=3
DEBUG=false
